<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Running number of the customer ID (YYYY.NNN). The year is taken from the
         registration date; this sequence only provides the NNN part and does not reset
         each year. Set "Next Number" to continue from the current aHPS register. -->
    <record id="seq_ahps_customer_number" model="ir.sequence">
        <field name="name">aHPS Customer Number</field>
        <field name="code">ahps.customer.number</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
