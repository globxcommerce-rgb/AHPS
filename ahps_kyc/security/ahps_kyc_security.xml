<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ahps_kyc" model="res.groups.privilege">
        <field name="name">Customer KYC</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_ahps_kyc_user" model="res.groups">
        <field name="name">KYC Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ahps_kyc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Collects KYC information and documents and submits KYCs for review.</field>
    </record>

    <record id="group_ahps_kyc_manager" model="res.groups">
        <field name="name">KYC Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ahps_kyc"/>
        <field name="implied_ids" eval="[(4, ref('group_ahps_kyc_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approves or rejects customer KYCs and can edit customer IDs.</field>
    </record>
</odoo>
