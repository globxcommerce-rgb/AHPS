<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ahps_kyc_document_view_list" model="ir.ui.view">
        <field name="name">ahps.kyc.document.list</field>
        <field name="model">ahps.kyc.document</field>
        <field name="arch" type="xml">
            <list string="KYC Documents" decoration-danger="is_expired">
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="name"/>
                <field name="attachment" filename="attachment_name" widget="binary"/>
                <field name="attachment_name" column_invisible="1"/>
                <field name="issue_date" optional="show"/>
                <field name="expiry_date" optional="show"/>
                <field name="is_expired" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ahps_kyc_document_view_form" model="ir.ui.view">
        <field name="name">ahps.kyc.document.form</field>
        <field name="model">ahps.kyc.document</field>
        <field name="arch" type="xml">
            <form string="KYC Document">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="document_type_id"/>
                            <field name="name"/>
                            <field name="attachment" filename="attachment_name"/>
                            <field name="attachment_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ahps_kyc_document_type_view_list" model="ir.ui.view">
        <field name="name">ahps.kyc.document.type.list</field>
        <field name="model">ahps.kyc.document.type</field>
        <field name="arch" type="xml">
            <list string="KYC Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="required"/>
                <field name="portal_visible"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_ahps_kyc_document_type" model="ir.actions.act_window">
        <field name="name">KYC Document Types</field>
        <field name="res_model">ahps.kyc.document.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
