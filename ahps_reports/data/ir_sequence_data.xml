<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Pro Forma Invoice number, e.g. PFI2026178 -->
    <record id="seq_ahps_pfi" model="ir.sequence">
        <field name="name">aHPS Pro Forma Invoice</field>
        <field name="code">ahps.pfi</field>
        <field name="prefix">PFI%(year)s</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
