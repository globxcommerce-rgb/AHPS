<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_ahps_reports" model="ir.ui.view">
        <field name="name">purchase.order.form.ahps.reports</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_location']" position="after">
                <field name="ahps_end_user_id"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="ahps_sale_order_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_ahps_reports" model="ir.ui.view">
        <field name="name">purchase.order.search.ahps.reports</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="ahps_sale_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
