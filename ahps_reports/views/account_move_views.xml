<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ahps_reports" model="ir.ui.view">
        <field name="name">account.move.form.ahps.reports</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']/field[@name='incoterm_location']" position="after">
                <field name="ahps_port_loading" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="ahps_final_destination" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
