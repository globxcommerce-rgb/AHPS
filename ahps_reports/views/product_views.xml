<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ahps_reports" model="ir.ui.view">
        <field name="name">product.template.form.ahps.reports</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="ahps_hs_code"/>
                <field name="ahps_country_of_origin_id" options="{'no_create': True}"/>
                <field name="ahps_charge_type"/>
            </xpath>
        </field>
    </record>
</odoo>
