<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ahps_document_logo_view_list" model="ir.ui.view">
        <field name="name">ahps.document.logo.list</field>
        <field name="model">ahps.document.logo</field>
        <field name="arch" type="xml">
            <list string="Document Logos" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [120, 40]}"/>
                <field name="name"/>
                <field name="usage"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_ahps_document_logo" model="ir.actions.act_window">
        <field name="name">Document Logos</field>
        <field name="res_model">ahps.document.logo</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a logo</p>
            <p>Partner logos are printed side by side at the bottom of quotations, pro forma invoices and invoices.
               Upload a new image, reorder them, or switch one off when a partnership changes.</p>
        </field>
    </record>

    <menuitem id="menu_ahps_document_logo" name="Document Logos" parent="sale.menu_sale_config"
              action="action_ahps_document_logo" sequence="90" groups="base.group_system"/>
</odoo>
